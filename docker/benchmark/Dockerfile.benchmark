FROM python:3.12-slim

ARG HOST_UID=1000
ARG HOST_GID=1000

# Install system dependencies and remove the apt package lists afterward.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        git \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user whose numeric UID/GID match the host user.
RUN groupadd \
        --gid "${HOST_GID}" \
        benchmark \
    && useradd \
        --uid "${HOST_UID}" \
        --gid "${HOST_GID}" \
        --create-home \
        --home-dir /home/benchmark \
        --shell /bin/bash \
        benchmark

ENV WORKSPACE_DIR=/home/benchmark/workspace

RUN mkdir -p "${WORKSPACE_DIR}"

# Application sources.
COPY heracles/heracles /home/benchmark/workspace/heracles
COPY heracles_agents /home/benchmark/workspace/heracles_agents

RUN pip install --no-cache-dir "${WORKSPACE_DIR}/heracles_agents[all]" \
    && pip install --no-cache-dir --force-reinstall --no-deps \
        "${WORKSPACE_DIR}/heracles"

# Copy the external benchmark script into the image.
COPY docker/benchmark/benchmark_runner.sh \
     /home/benchmark/workspace/benchmark_runner.sh

RUN chmod 0755 /home/benchmark/workspace/benchmark_runner.sh \
    && chown -R benchmark:benchmark \
        /home/benchmark

USER benchmark:benchmark

WORKDIR /home/benchmark/workspace

ENV USER=benchmark
ENV HOME=/home/benchmark

CMD ["bash"]
